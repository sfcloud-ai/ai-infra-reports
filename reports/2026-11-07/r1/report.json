  "entries": [
    {
      "id": "2026-11-07-vllm-pr-66010",
      "event_key": "vllm-pr-66010",
      "title": "vLLM Level 2休眠：只丢可重写参数，保留运行结构",
      "summary": "11月6日已合并f8b116409c4cdf02cee4bb7eca8e6bb9780c2e35，晚于当前最新v0.33.0rc3及稳定版v0.32.0。Level2过去按weights池整体丢弃，但该池还装有模型加载时建立的指针表、闭包中的排列索引和量化缓存；这些并非参数，更新权重不会重建。现在worker提交将重写参数的storage地址，分配器只有在某块allocation的全部live block都可丢弃时才舍弃整块，其余备份到CPU并原地址恢复。保留参数仍可用sleep_preserve_parameter_names指定。",
      "source_urls": [
        "https://api.github.com/repos/vllm-project/vllm/pulls/66010",
        "https://api.github.com/repos/vllm-project/vllm/commits/f8b116409c4cdf02cee4bb7eca8e6bb9780c2e35",
        "https://api.github.com/repos/vllm-project/vllm/releases?per_page=6"
      ],
      "update_of": null,
      "article_id": "inference-engines"
    },
    {
      "id": "2026-11-07-sglang-pr-48496",
      "event_key": "sglang-pr-48496",
      "title": "SGLang统一页回收：等待旧读者的是新写者，不是整个调度流",
      "summary": "11月6日已合并adeec96c4ca6a83271a6df5e6c10d9f8428371d2，承接同日#48450的正确性修复，当前稳定v0.5.23未包含。统一内存的lazy回收原先认为虚拟ID释放就无读者，但正在运行的forward已准备的attention页表仍可能读原物理页。#48450让调度stream等待forward完成；#48496把释放页与完成event一起暂存，平时完成后入free list，压力下提前交出页面但给重写操作加reuse fence：清零放到forward stream，紧急搬移在host读取索引之后等待，decode对RDMA目的地址的发布也等待fence。",
      "source_urls": [
        "https://api.github.com/repos/sgl-project/sglang/pulls/48496",
        "https://api.github.com/repos/sgl-project/sglang/pulls/48450",
        "https://api.github.com/repos/sgl-project/sglang/commits/adeec96c4ca6a83271a6df5e6c10d9f8428371d2",
        "https://api.github.com/repos/sgl-project/sglang/releases?per_page=6"
      ],
      "update_of": null,
      "article_id": "inference-engines"
    },
    {
      "id": "2026-11-07-arxiv-2611-08458-v1",
      "event_key": "arxiv-2611-08458-v1",
      "title": "Latent RL Prior：冻结控制先验，少样本学习视觉接口",
      "summary": "先用特权状态RL教师100000条成功轨迹训练flow-matching动作解码器；再冻结解码器，用DINOv2-Small和视觉Q-Former把图像映射为上下文token，仅用动作监督。双臂用联合query推断左右上下文，分别调用同一冻结单臂解码器。",
      "source_urls": [
        "https://arxiv.org/abs/2611.08458v1",
        "https://arxiv.org/html/2611.08458v1"
      ],
      "update_of": null,
      "article_id": "embodied-training"
    },
    {
      "id": "2026-11-07-arxiv-2611-02543-v1",
      "event_key": "arxiv-2611-02543-v1",
      "title": "Basin：突发后的缓存失速，需要会话级准入",
      "summary": "突发增加活跃会话与上下文工作集，缓存miss放大prefill重算，再延长会话形成持续失速。Basin在网关准入、按固定优先级排队、借用空闲decode存储prompt状态并削减持续过载需求。硬件原型按到达时间排序并按当前上下文准入；完整峰值预测版本只在模拟评估。",
      "source_urls": [
        "https://arxiv.org/abs/2611.02543v1",
        "https://arxiv.org/html/2611.02543v1"
      ],
      "update_of": null,
      "article_id": "model-serving-gpu"
    },
    {
      "id": "2026-11-07-lmcache-pr-6358",
      "event_key": "lmcache-pr-6358",
      "title": "LMCache：sleep先解除VMM进口，wake重绑新物理页",
      "summary": "LMCacheMPConnector新增unregister/restore hooks。释放KV前等待已跟踪store/retrieve、撤下transfer context并注销服务端映射，wake后为同一虚址重新导出新物理块。注册锁让心跳恢复与释放串行，睡眠期间阻止重注册；服务端已故障时wake降级，后续心跳重注册。",
      "source_urls": [
        "https://raw.githubusercontent.com/LMCache/LMCache/012965f888cccaa5102cec7a745990f60e8ca721/docs/design/integration/vllm/mp_sleep_mode.md",
        "https://raw.githubusercontent.com/LMCache/LMCache/012965f888cccaa5102cec7a745990f60e8ca721/lmcache/integration/vllm/vllm_multi_process_adapter.py",
        "https://api.github.com/repos/LMCache/LMCache/pulls/6358/files?per_page=100",
        "https://api.github.com/repos/LMCache/LMCache/commits?since=2026-10-30T23:26:51Z&until=2026-11-06T23:26:51Z&per_page=100"
      ],
      "update_of": null,
      "article_id": "model-serving-gpu"
    },
    {
      "id": "2026-11-07-vllm-zero-mismatch-async-rl-20261106",
      "event_key": "vllm-zero-mismatch-async-rl-20261106",
      "title": "异步RL先消掉内核误差：缓存命中也必须数值一致",
      "summary": "新技术文章把同权重kernel误差与异步旧权重滞后分开：先逐位对齐rollout/learner概率，再用采样时的真实token logprob作不裁剪IS。DeepSeek V4.1要求SWA prefix hit/miss及MTP路径一致；Kimi KDA保存chunk入口FP32状态、已完成行和位置，让decode重算与prefill相同的行表达式。论文1.5B BF16实验16GPU/12K updates、128 responses/update，异步2+14 learner/rollout训练步时间68.55h对同步TII164.77h（2.40×，排除评估），该组GPU SKU未给出。Qwen3-4B lag64图示持续到5K更新，附录总计6K。",
      "source_urls": [
        "https://raw.githubusercontent.com/vllm-project/vllm-project.github.io/main/_posts/2026-11-06-zero-mismatch-async-rl.md",
