---
import Shell from "../layouts/Shell.astro";
import Navigation from "../components/Navigation.astro";
import {pages,recentDays,href,preview} from "../data/navigation.mjs";
const days=recentDays;
---
<Shell title="近期报告" description="按日期阅读 AI 基础设施研究、系统机制与工程实践。" current="">
<div class="docs-layout archive-layout">
<aside class="sidebar"><div class="edition">近期索引 <span>RECENT</span></div><Navigation /></aside>
<main id="content" class="doc-main archive-main" data-pagefind-body>
<div class="eyebrow">AI INFRASTRUCTURE · DAILY NOTES</div>
<h1 data-pagefind-meta="title">把进展读深，把边界看清。</h1>
<p class="doc-intro">AI 基础设施的每日观察。展示最近一期往前七天的报告，随新一期发布自动更新。历史内容可通过搜索继续阅读。</p>
{preview&&<p class="preview-notice">合成样例预览 · 内容仅用于检验页面与搜索，不是正式晨报。</p>}
<div class="archive-heading"><h2>近期报告</h2><span>最近七天 · {days.length} 期</span></div>
{days.length?days.map(day=><section class="day-card"><div class="day-meta"><time datetime={day.date}>{day.date}</time></div><h2><a href={href(day.slug)}>{day.title}</a></h2><p>{day.description}</p><ul>{pages.filter(p=>p.parent===day.slug).map(p=><li><a href={href(p.slug)}>{p.title}<span aria-hidden="true">↗</span></a></li>)}</ul><a class="day-link" href={href(day.slug)}>阅读本期概览 →</a></section>):<div class="empty-state"><h2>等待第一期报告</h2><p>通过内容校验并发布后，这里会出现日期索引和独立文章。</p></div>}
</main>
<aside class="table-of-contents archive-note"><span class="eyebrow">阅读方式</span><p>最近七天，按日期浏览，按主题深入。</p><p>搜索可查找历史报告的正文与章节。每篇文章保留来源、实验条件与限制。</p></aside>
</div>
</Shell>
