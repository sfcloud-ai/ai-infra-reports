---
import Shell from "../layouts/Shell.astro";
import manifest from "../../generated/manifest.json";
import {href} from "../data/navigation.mjs";
---
<Shell title="页面不存在" description="这个地址没有对应的报告。" noindex={true}>
<main id="content" class="not-found"><div class="eyebrow">404</div><h1>没有找到这篇报告</h1><p>可以搜索关键词，或返回日期索引。</p><a href={href()}>返回报告归档 →</a></main>
</Shell>

<script define:vars={{days:manifest.legacyDays||{}}}>
 const match=/^\/ai-infra-reports\/(\d{4}-\d\d-\d\d)\/r[1-9]\d*(?:\/([a-z0-9][a-z0-9-]{0,79}))?\/?$/.exec(window.location.pathname);
 if(match&&Object.hasOwn(days,match[1])){
  const article=match[2]&&days[match[1]].includes(match[2])?match[2]+'/':'';
  window.location.replace('/ai-infra-reports/'+match[1]+'/'+article+window.location.search+window.location.hash);
 }
</script>
